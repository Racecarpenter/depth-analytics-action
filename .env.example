# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL, used to build invite links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign invite tokens (openssl rand -hex 32)
INVITE_TOKEN_SECRET=replace-with-a-long-random-string

# Secret required in the Authorization header of the settlement cron route
CRON_SECRET=replace-with-a-long-random-string

# --- SMS provider ---
# "mock" logs invite links (and, in dev, OTP codes) to the server console
# instead of sending real SMS. Set to "twilio" to send real SMS/OTP once
# Twilio credentials are provided below. Both TWILIO_MESSAGING_SERVICE_SID
# and TWILIO_VERIFY_SERVICE_SID are Twilio *product* SIDs and are unrelated
# to each other, but both live under the same TWILIO_ACCOUNT_SID/
# TWILIO_AUTH_TOKEN pair.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Used by TwilioSmsProvider for every transactional SMS EXCEPT login OTP —
# Action invitations, results, nudges, payment reminders, status updates.
# Prefer TWILIO_MESSAGING_SERVICE_SID over TWILIO_FROM_NUMBER once you have
# an A2P 10DLC campaign registered — that's what the campaign actually
# attaches to, and what makes Twilio's Advanced Opt-Out (automatic STOP/HELP
# handling) apply. TWILIO_FROM_NUMBER is the fallback for a bare number with
# no Messaging Service configured yet. See README ("SMS consent & Twilio
# A2P 10DLC") for the full setup.
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Used ONLY by the login-OTP flow (requestOtp/verifyOtp) via Twilio Verify
# v2 — a separate Twilio product from the Messaging Service above. Create a
# Verify Service in Twilio Console → Verify → Services and paste its SID
# here. Twilio Verify generates, texts, expires, and rate-limits the code
# itself; this app never sees or stores the code. See README ("How phone
# auth actually works") for the full picture.
TWILIO_VERIFY_SERVICE_SID=

# --- Sports data provider ---
# "mock" uses seeded, deterministic in-memory data. Swap to "the-odds-api" when ready.
SPORTS_DATA_PROVIDER=mock
THE_ODDS_API_KEY=

# --- Stripe (monetization) ---
# Secret key from https://dashboard.stripe.com/apikeys (use a test-mode key
# for local dev).
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint. In production this comes from the
# webhook's settings page in the Stripe dashboard; for local dev, `stripe
# listen` prints one each time you run it — see README for both.
STRIPE_WEBHOOK_SECRET=

# Price IDs for the two one-time products (Stripe dashboard -> Product
# catalog, or created via the Stripe CLI). Quantities/amounts themselves are
# not read from Stripe — see src/lib/monetization/pricing.ts for the source
# of truth on what each price actually grants.
STRIPE_PRICE_ACTION_PACK=
STRIPE_PRICE_ACTION_PASS=

# --- Beta paywall credits (temporary, remove when Stripe goes live) ---
# When STRIPE_PRICE_ACTION_PACK/STRIPE_PRICE_ACTION_PASS aren't set above,
# the paywall shows those options as "Coming soon" instead of a live
# checkout button. Separately, "true" here shows authorized beta testers
# (see README "Beta testing access") a free, repeatable "+5 Actions" option
# once their balance actually reaches zero — the same credit ledger a real
# Stripe purchase uses, no payment involved. Requires BOTH this flag AND
# beta-tester status; set to "false" (or unset) to kill the option
# everywhere with no other code changes. See
# src/features/monetization/lib/beta-credits.ts.
ENABLE_BETA_FREE_CREDITS=false
