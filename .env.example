# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public base URL, used to build invite links (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign invite tokens (openssl rand -hex 32)
INVITE_TOKEN_SECRET=replace-with-a-long-random-string

# Secret required in the Authorization header of the settlement cron route
CRON_SECRET=replace-with-a-long-random-string

# --- SMS provider ---
# "mock" logs invite links to the server console instead of sending real SMS.
# Set to "twilio" to send real SMS once Twilio credentials are provided below.
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Sports data provider ---
# "mock" uses seeded, deterministic in-memory data. Swap to "the-odds-api" when ready.
SPORTS_DATA_PROVIDER=mock
THE_ODDS_API_KEY=

# --- Stripe (monetization) ---
# Secret key from https://dashboard.stripe.com/apikeys (use a test-mode key
# for local dev).
STRIPE_SECRET_KEY=

# Signing secret for the webhook endpoint. In production this comes from the
# webhook's settings page in the Stripe dashboard; for local dev, `stripe
# listen` prints one each time you run it — see README for both.
STRIPE_WEBHOOK_SECRET=

# Price IDs for the two one-time products (Stripe dashboard -> Product
# catalog, or created via the Stripe CLI). Quantities/amounts themselves are
# not read from Stripe — see src/lib/monetization/pricing.ts for the source
# of truth on what each price actually grants.
STRIPE_PRICE_ACTION_PACK=
STRIPE_PRICE_ACTION_PASS=
